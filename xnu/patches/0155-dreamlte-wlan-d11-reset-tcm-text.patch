+/* After a failed start: the printable text the firmware wrote between its image and the NVRAM
+ * (console buffer, trap or assert messages), as runs of at least 12 characters. */
+static void
+tcm_text(uint32_t from, uint32_t to)
+{
+	char run[121];
+	unsigned n = 0, runs = 0;
+	uint32_t start = 0;
+	LOG("6: text in TCM %#x..%#x:", from, to);
+	for (uint32_t a = from & ~3u; a < to && runs < 80; a += 4) {
+		uint32_t w = tcm_rd(a);
+		for (int b = 0; b < 4; b++) {
+			char ch = (char)(w >> (8 * b));
+			bool pr = (ch >= 0x20 && ch < 0x7f) || ch == '\n';
+			if (pr && n < sizeof(run) - 1) {
+				if (n == 0) {
+					start = a + (uint32_t)b;
+				}
+				run[n++] = ch == '\n' ? '|' : ch;
+				continue;
+			}
+			if (n >= 12) {
+				run[n] = 0;
+				LOG("6: %#x: %s", start, run);
+				runs++;
+			}
+			n = 0;
+			if (pr) {
+				start = a + (uint32_t)b;
+				run[n++] = ch == '\n' ? '|' : ch;
+			}
+		}
+	}
+	LOG("6: %u text runs", runs);
+}
