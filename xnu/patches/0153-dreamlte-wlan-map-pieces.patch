@@ -134,10 +134,29 @@ extern void flush_dcache(vm_offset_t addr, unsigned count, int phys);
 #define BCMA_PCI_BAR0_WINDOW            0x80
 #define SI_ENUM_BASE                    0x18000000u
 
-static volatile uint8_t *elbi, *pcs, *phy, *dbi, *mem, *pmu, *sysreg, *cmu_fsys1, *cmu_top, *gpj1;
+static volatile uint8_t *elbi, *pcs, *phy, *dbi, *pmu, *sysreg, *cmu_fsys1, *cmu_top, *gpj1;
 static uint32_t s8wlan_steps;
 static volatile bool s8wlan_done;
 
+/*
+ * The 4 MiB PCIe window (BAR2, BAR0 window, config) is mapped in 128 KiB pieces, on first use:
+ * one ml_io_map() of 4 MiB comes from the kernel's large VA range, which is used up on a full
+ * iOS boot (panic "kmem_alloc(..., 4194304, ...) failed with 3").
+ */
+#define MEM_PIECE_SHIFT 17
+static volatile uint8_t *mem_piece[MEM_SIZE >> MEM_PIECE_SHIFT];
+
+static volatile uint8_t *
+memp(uint32_t o)
+{
+	uint32_t i = o >> MEM_PIECE_SHIFT;
+	if (mem_piece[i] == NULL) {
+		mem_piece[i] = (volatile uint8_t *)ml_io_map(MEM_PA + ((vm_offset_t)i << MEM_PIECE_SHIFT),
+		    1u << MEM_PIECE_SHIFT);
+	}
+	return mem_piece[i] + (o & ((1u << MEM_PIECE_SHIFT) - 1));
+}
+
 static inline uint32_t rd(volatile uint8_t *b, uint32_t o) { return *(volatile uint32_t *)(b + o); }
 static inline void wr(volatile uint8_t *b, uint32_t o, uint32_t v) { *(volatile uint32_t *)(b + o) = v; __asm__ volatile ("dsb sy" ::: "memory"); }
 static inline void set(volatile uint8_t *b, uint32_t o, uint32_t clr, uint32_t s) { wr(b, o, (rd(b, o) & ~clr) | s); }
@@ -251,13 +270,14 @@ atu(uint32_t index, uint32_t type, uint32_t cpu, uint32_t limit, uint32_t target
 static uint32_t
 ep_cfg_rd(uint32_t o)
 {
-	return rd(mem, (CFG_PA - MEM_PA) + o);
+	return *(volatile uint32_t *)memp((uint32_t)(CFG_PA - MEM_PA) + o);
 }
 
 static void
 ep_cfg_wr(uint32_t o, uint32_t v)
 {
-	wr(mem, (CFG_PA - MEM_PA) + o, v);
+	*(volatile uint32_t *)memp((uint32_t)(CFG_PA - MEM_PA) + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
 }
 
 static void
@@ -487,7 +507,7 @@ step_bars(void)
 	ep_cfg_wr(BCMA_PCI_BAR0_WINDOW, SI_ENUM_BASE);
 	LOG("5: BAR0 %#x BAR2 %#x cmd %#x window %#x", ep_cfg_rd(0x10), ep_cfg_rd(0x18), ep_cfg_rd(0x04),
 	    ep_cfg_rd(BCMA_PCI_BAR0_WINDOW));
-	uint32_t chipid = rd(mem, BAR0_CPU - MEM_PA);
+	uint32_t chipid = *(volatile uint32_t *)memp(BAR0_CPU - MEM_PA);
 	LOG("5: chipcommon chipid %#x (chip %#x rev %u pkg %u)", chipid, chipid & 0xffff, (chipid >> 16) & 0xf,
 	    (chipid >> 20) & 0xf);
 	return (chipid & 0xffff) == 0x4361 ? 0 : ENODEV;
@@ -503,7 +523,7 @@ bp_rd(uint32_t addr)
 		bar0_window = addr & ~0xfffu;
 		ep_cfg_wr(BCMA_PCI_BAR0_WINDOW, bar0_window);
 	}
-	return rd(mem, (BAR0_CPU - MEM_PA) + (addr & 0xfffu));
+	return *(volatile uint32_t *)memp((BAR0_CPU - MEM_PA) + (addr & 0xfffu));
 }
 
 static void
@@ -513,12 +533,13 @@ bp_wr(uint32_t addr, uint32_t v)
 		bar0_window = addr & ~0xfffu;
 		ep_cfg_wr(BCMA_PCI_BAR0_WINDOW, bar0_window);
 	}
-	wr(mem, (BAR0_CPU - MEM_PA) + (addr & 0xfffu), v);
+	*(volatile uint32_t *)memp((BAR0_CPU - MEM_PA) + (addr & 0xfffu)) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
 }
 
 /* TCM (the ARM's RAM) through BAR2 */
-static inline uint32_t tcm_rd(uint32_t o) { return rd(mem, o); }
-static inline void tcm_wr(uint32_t o, uint32_t v) { *(volatile uint32_t *)(mem + o) = v; }
+static inline uint32_t tcm_rd(uint32_t o) { return *(volatile uint32_t *)memp(o); }
+static inline void tcm_wr(uint32_t o, uint32_t v) { *(volatile uint32_t *)memp(o) = v; }
 
 #define BCMA_IOCTL              0x408
