+/* ---- step 7: the msgbuf protocol (brcmfmac pcie.c, msgbuf.c, commonring.c), all polled ---- */
+
+/* pcie_shared fields (brcmf_pcie_init_share_ram_info) */
+#define SH_MAX_RXBUFPOST        34
+#define SH_RX_DATAOFFSET        36
+#define SH_RING_INFO_ADDR       48
+#define SH_DMA_SCRATCH_LEN      52
+#define SH_DMA_SCRATCH_ADDR     56
+#define SH_DMA_RINGUPD_LEN      64
+#define SH_DMA_RINGUPD_ADDR     68
+#define SH_HOST_CAP             84
+#define SH_HOST_CAP2            96
+#define SH_FLAG_DMA_INDEX       0x10000u
+#define SH_FLAG_HOSTRDY_DB1     0x10000000u
+#define HOSTCAP_H2D_ENABLE_HOSTRDY 0x400u
+#define HOSTCAP_DS_NO_OOB_DW    0x1000u
+
+/* PCIE2 core registers, through the BAR0 window */
+#define PCIE2_MAILBOXINT        0x48
+#define PCIE2_MAILBOXMASK       0x4c
+#define PCIE2_H2D_MAILBOX_0     0x140
+#define PCIE2_H2D_MAILBOX_1     0x144
+
+/* message types (msgbuf.c) */
+#define MT_GEN_STATUS           0x1
+#define MT_RING_STATUS          0x2
+#define MT_IOCTLPTR_REQ         0x9
+#define MT_IOCTLPTR_REQ_ACK     0xa
+#define MT_IOCTLRESP_BUF_POST   0xb
+#define MT_IOCTL_CMPLT          0xc
+#define MT_EVENT_BUF_POST       0xd
+#define MT_WL_EVENT             0xe
+
+#define IOCTL_REQ_PKTID         0xfffe
+#define IOCT_MAX                1518    /* BRCMF_TX_IOCTL_MAX_MSG_SIZE */
+#define CTL_BUF_SIZE            8192    /* BRCMF_MSGBUF_MAX_CTL_PKT_SIZE */
+#define NRESP                   8
+#define NEVENT                  8
+
+/* dongle commands (fwil.h) */
+#define WLC_UP                  2
+#define WLC_SET_INFRA           20
+#define WLC_SET_PM              86
+#define WLC_GET_VAR             262
+#define WLC_SET_VAR             263
+
+struct wring {
+	uint8_t *va;
+	uint64_t pa;
+	uint16_t max, isz, w, r;
+	uint32_t widx, ridx;            /* TCM addresses of the indices */
+};
+
+/* common rings: H2D control submit, H2D rx post, D2H control complete, D2H tx complete, D2H rx complete */
+static const uint16_t ring_max[5] = { 64, 512, 64, 1024, 512 };
+static const uint16_t ring_isz_v7[5] = { 40, 32, 24, 24, 40 };
+static const uint16_t ring_isz_pre7[5] = { 40, 32, 24, 16, 32 };
+static struct wring rings[5];
+#define R_CTRL_SUB      (&rings[0])
+#define R_CTRL_CPL      (&rings[2])
+
+static uint8_t *dma_va;
+static uint64_t dma_pa;
+static uint32_t dma_used, dma_size;
+static uint8_t *ioct_va, *resp_va[NRESP + NEVENT];
+static uint64_t ioct_pa, resp_pa[NRESP + NEVENT];
+static uint32_t rx_dataoffset;
+static uint16_t ioctl_tid;
+static struct bcm_core *pcie2;
+static int wl_version;
+
+static inline uint16_t tcm_rd16(uint32_t o) { return *(volatile uint16_t *)(mem + o); }
+static inline void tcm_wr16(uint32_t o, uint16_t v) { *(volatile uint16_t *)(mem + o) = v; __asm__ volatile ("dsb sy" ::: "memory"); }
+static inline void put16(uint8_t *p, uint16_t v) { memcpy(p, &v, 2); }
+static inline void put32(uint8_t *p, uint32_t v) { memcpy(p, &v, 4); }
+static inline uint16_t get16(const uint8_t *p) { uint16_t v; memcpy(&v, p, 2); return v; }
+static inline uint32_t get32(const uint8_t *p) { uint32_t v; memcpy(&v, p, 4); return v; }
+static inline uint32_t get32be(const uint8_t *p) { return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3]; }
+
+static void *
+dma_carve(uint32_t size, uint64_t *pa)
+{
+	uint32_t off = (dma_used + 127) & ~127u;
+	if (off + size > dma_size) {
+		return NULL;
+	}
+	dma_used = off + size;
+	*pa = dma_pa + off;
+	return dma_va + off;
+}
+
+static void
+ring_bell(void)
+{
+	bp_wr(pcie2->base + PCIE2_H2D_MAILBOX_0, 1);
+}
+
+/* next free H2D slot, or NULL when the ring is full (brcmf_commonring_reserve_for_write) */
+static uint8_t *
+ring_reserve(struct wring *rg)
+{
+	uint16_t rp = tcm_rd16(rg->ridx);
+	uint16_t avail = rp > rg->w ? rp - rg->w : rg->max - rg->w + rp;
+	if (avail <= 1) {
+		return NULL;
+	}
+	uint8_t *slot = rg->va + (uint32_t)rg->w * rg->isz;
+	bzero(slot, rg->isz);
+	return slot;
+}
+
+static void
+ring_commit(struct wring *rg)
+{
+	uint8_t *slot = rg->va + (uint32_t)rg->w * rg->isz;
+	clean_dcache((vm_offset_t)slot, rg->isz, 0);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	rg->w = (uint16_t)((rg->w + 1) % rg->max);
+	tcm_wr16(rg->widx, rg->w);
+	ring_bell();
+}
+
+static int
+post_buf(uint8_t type, uint32_t id)
+{
+	uint8_t *m = ring_reserve(R_CTRL_SUB);
+	if (m == NULL) {
+		return ENOSPC;
+	}
+	m[0] = type;
+	put32(m + 4, id);                       /* request_id: our buffer number */
+	put16(m + 8, CTL_BUF_SIZE);             /* host_buf_len */
+	put32(m + 16, (uint32_t)resp_pa[id]);   /* host_buf_addr */
+	put32(m + 20, (uint32_t)(resp_pa[id] >> 32));
+	ring_commit(R_CTRL_SUB);
+	return 0;
+}
+
+/* scan results, filled by the event handler */
+#define MAX_NETS 40
+static struct { uint8_t bssid[6]; char ssid[33]; uint16_t chanspec; int16_t rssi; } nets[MAX_NETS];
+static unsigned nnets;
+static int escan_status = -1;           /* -1 running, else the final event status */
+static unsigned nevents;
+
+#define WLC_E_ESCAN_RESULT      69
+#define WLC_E_STATUS_PARTIAL    8
+
+static void
+handle_event(const uint8_t *d, uint32_t len)
+{
+	nevents++;
+	/* ethernet header (14), bcmeth header (10), brcmf_event_msg_be (48), then the data */
+	if (len < 72 || d[12] != 0x88 || d[13] != 0x6c) {
+		return;
+	}
+	const uint8_t *em = d + 24;
+	uint32_t type = get32be(em + 4), status = get32be(em + 8), dlen = get32be(em + 24);
+	const uint8_t *ed = d + 72;
+	if (type != WLC_E_ESCAN_RESULT) {
+		LOG("8: event %u status %u", type, status);
+		return;
+	}
+	if (status != WLC_E_STATUS_PARTIAL) {
+		escan_status = (int)status;
+		return;
+	}
+	/* brcmf_escan_result_le: buflen, version, sync_id, bss_count, then brcmf_bss_info_le */
+	if (dlen < 12 + 80 || 72 + dlen > len) {
+		return;
+	}
+	const uint8_t *bi = ed + 12;
+	unsigned n;
+	for (n = 0; n < nnets && memcmp(nets[n].bssid, bi + 8, 6) != 0; n++) {
+	}
+	if (n == MAX_NETS) {
+		return;
+	}
+	if (n == nnets) {
+		nnets++;
+	}
+	memcpy(nets[n].bssid, bi + 8, 6);
+	uint8_t sl = bi[18] > 32 ? 32 : bi[18];
+	memcpy(nets[n].ssid, bi + 19, sl);
+	nets[n].ssid[sl] = 0;
+	nets[n].chanspec = get16(bi + 72);
+	nets[n].rssi = (int16_t)get16(bi + 78);
+}
+
+/* Drain the control completion ring. Returns the status of the ioctl "tid" when its completion
+ * is seen (and copies its response into out), else 1. */
+static int
+ctrl_poll(uint16_t tid, uint8_t *out, uint32_t outlen, uint32_t *gotlen)
+{
+	struct wring *rg = R_CTRL_CPL;
+	int result = 1;
+	uint16_t w = tcm_rd16(rg->widx);
+	if (w >= rg->max) {
+		return result;
+	}
+	while (rg->r != w) {
+		uint8_t *m = rg->va + (uint32_t)rg->r * rg->isz;
+		flush_dcache((vm_offset_t)m, rg->isz, 0);
+		uint8_t type = m[0];
+		uint32_t id = get32(m + 4);
+		int16_t status = (int16_t)get16(m + 8);
+		switch (type) {
+		case MT_IOCTL_CMPLT: {
+			uint16_t rlen = get16(m + 12), rtid = get16(m + 14);
+			if (id < NRESP) {
+				if (rtid == tid) {
+					uint32_t n = rlen < outlen ? rlen : outlen;
+					flush_dcache((vm_offset_t)resp_va[id], CTL_BUF_SIZE, 0);
+					if (out != NULL) {
+						memcpy(out, resp_va[id], n);
+					}
+					if (gotlen != NULL) {
+						*gotlen = n;
+					}
+					result = status;
+				}
+				post_buf(MT_IOCTLRESP_BUF_POST, id);
+			}
+			break;
+		}
+		case MT_WL_EVENT: {
+			uint16_t elen = get16(m + 12);
+			if (id >= NRESP && id < NRESP + NEVENT) {
+				flush_dcache((vm_offset_t)resp_va[id], CTL_BUF_SIZE, 0);
+				if (rx_dataoffset + elen <= CTL_BUF_SIZE) {
+					handle_event(resp_va[id] + rx_dataoffset, elen);
+				}
+				post_buf(MT_EVENT_BUF_POST, id);
+			}
+			break;
+		}
+		case MT_IOCTLPTR_REQ_ACK:
+			if (status != 0) {
+				LOG("7: ioctl ack status %d", status);
+			}
+			break;
+		default:
+			LOG("7: control completion type %#x status %d", type, status);
+			break;
+		}
+		rg->r = (uint16_t)((rg->r + 1) % rg->max);
+		tcm_wr16(rg->ridx, rg->r);
+	}
+	return result;
+}
+
+/* One dongle ioctl: len bytes of buf in, at most len bytes back into buf. Returns the firmware's status. */
+static int
+wl_ioctl(uint32_t cmd, uint8_t *buf, uint32_t len, uint32_t *gotlen)
+{
+	if (len > IOCT_MAX) {
+		len = IOCT_MAX;
+	}
+	memcpy(ioct_va, buf, len);
+	clean_dcache((vm_offset_t)ioct_va, IOCT_MAX, 0);
+	uint8_t *m = ring_reserve(R_CTRL_SUB);
+	if (m == NULL) {
+		return -1000;
+	}
+	uint16_t tid = ++ioctl_tid;
+	m[0] = MT_IOCTLPTR_REQ;
+	put32(m + 4, IOCTL_REQ_PKTID);
+	put32(m + 8, cmd);
+	put16(m + 12, tid);
+	put16(m + 14, (uint16_t)len);           /* input_buf_len */
+	put16(m + 16, (uint16_t)len);           /* output_buf_len */
+	put32(m + 24, (uint32_t)ioct_pa);       /* req_buf_addr */
+	put32(m + 28, (uint32_t)(ioct_pa >> 32));
+	ring_commit(R_CTRL_SUB);
+	for (int i = 0; i < 2000; i++) {        /* 2 s */
+		int r = ctrl_poll(tid, buf, len, gotlen);
+		if (r != 1) {
+			return r;
+		}
+		IOSleep(1);
+	}
+	return -1001;
+}
+
+static int
+iovar_get(const char *name, uint8_t *out, uint32_t outlen)
+{
+	uint8_t b[IOCT_MAX];
+	uint32_t nl = (uint32_t)strlen(name) + 1, len = outlen > nl ? outlen : nl, got = 0;
+	if (len > IOCT_MAX) {
+		len = IOCT_MAX;
+	}
+	bzero(b, len);
+	memcpy(b, name, nl);
+	int r = wl_ioctl(WLC_GET_VAR, b, len, &got);
+	memcpy(out, b, outlen < len ? outlen : len);
+	return r;
+}
+
+static int
+iovar_set(const char *name, const void *data, uint32_t dlen)
+{
+	uint8_t b[IOCT_MAX];
+	uint32_t nl = (uint32_t)strlen(name) + 1;
+	if (nl + dlen > IOCT_MAX) {
+		return -1002;
+	}
+	memcpy(b, name, nl);
+	memcpy(b + nl, data, dlen);
+	return wl_ioctl(WLC_SET_VAR, b, nl + dlen, NULL);
+}
+
+static int
+cmd_int(uint32_t cmd, uint32_t v)
+{
+	uint8_t b[4];
+	put32(b, v);
+	return wl_ioctl(cmd, b, 4, NULL);
+}
+
+/* "clmload" in 1400-byte chunks (brcmf_c_process_clm_blob) */
+static void
+clm_load(void)
+{
+	if (wclm == NULL) {
+		LOG("7: no CLM blob (ADT s8-wlan-clm): the firmware keeps its built-in regulatory data");
+		return;
+	}
+	uint8_t b[12 + 1400];
+	int r = 0;
+	for (uint32_t off = 0; off < wclm_len && r == 0; off += 1400) {
+		uint32_t n = wclm_len - off > 1400 ? 1400 : wclm_len - off;
+		uint16_t flag = 1u << 12;               /* DLOAD_HANDLER_VER */
+		if (off == 0) {
+			flag |= 0x2;                    /* DL_BEGIN */
+		}
+		if (off + n >= wclm_len) {
+			flag |= 0x4;                    /* DL_END */
+		}
+		put16(b, flag);
+		put16(b + 2, 2);                        /* DL_TYPE_CLM */
+		put32(b + 4, n);
+		put32(b + 8, 0);
+		memcpy(b + 12, wclm + off, n);
+		r = iovar_set("clmload", b, 12 + n);
+	}
+	uint8_t st[4] = { 0 };
+	int r2 = iovar_get("clmload_status", st, 4);
+	LOG("7: CLM blob %u bytes: clmload %d, clmload_status %d/%u", wclm_len, r, r2, get32(st));
+}
+
+/* The firmware's own console (brcmf_pcie_bus_console_read): new text since the last call, line by line. */
+static uint32_t con_ridx;
+
+static void
+fw_console(const char *when)
+{
+	uint32_t c = tcm_rd(wlan_shared + 20);
+	if (c < WLAN_RAMBASE || c >= WLAN_RAMBASE + wlan_ramsize) {
+		return;
+	}
+	uint32_t buf = tcm_rd(c + 8), size = tcm_rd(c + 12), widx = tcm_rd(c + 16);
+	if (size == 0 || size > 0x10000 || widx >= size || buf < WLAN_RAMBASE || buf + size > WLAN_RAMBASE + wlan_ramsize) {
+		return;
+	}
+	char line[161];
+	unsigned n = 0, total = 0;
+	LOG("fw console (%s):", when);
+	while (con_ridx != widx && total < 6000) {
+		uint32_t w = tcm_rd(buf + (con_ridx & ~3u));
+		char ch = (char)(w >> (8 * (con_ridx & 3)));
+		con_ridx = (con_ridx + 1) % size;
+		total++;
+		if (ch == '\r') {
+			continue;
+		}
+		if (ch == '\n' || n == sizeof(line) - 1) {
+			line[n] = 0;
+			if (n) {
+				LOG("fw: %s", line);
+			}
+			n = 0;
+			if (ch == '\n') {
+				continue;
+			}
+		}
+		line[n++] = (ch >= 0x20 && ch < 0x7f) ? ch : '.';
+	}
+	if (n) {
+		line[n] = 0;
+		LOG("fw: %s", line);
+	}
+}
