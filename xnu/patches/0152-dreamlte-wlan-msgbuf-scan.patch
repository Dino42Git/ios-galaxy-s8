+static int
+step_msgbuf(void)
+{
+	uint32_t sh = wlan_shared, flags = tcm_rd(sh);
+	wl_version = flags & 0xff;
+	if (wl_version < 5 || wl_version > 7) {
+		LOG("7: unsupported protocol version %d", wl_version);
+		return ENOTSUP;
+	}
+	if (flags & SH_FLAG_DMA_INDEX) {
+		LOG("7: firmware wants ring indices in host memory (flags %#x): not supported", flags);
+		return ENOTSUP;
+	}
+	pcie2 = core_find(CORE_PCIE2, 0);
+	if (pcie2 == NULL) {
+		LOG("7: no PCIE2 core");
+		return ENODEV;
+	}
+	rx_dataoffset = tcm_rd(sh + SH_RX_DATAOFFSET);
+	uint32_t ri = tcm_rd(sh + SH_RING_INFO_ADDR);
+	uint32_t ringmem = tcm_rd(ri), h2dw = tcm_rd(ri + 4), h2dr = tcm_rd(ri + 8), d2hw = tcm_rd(ri + 12),
+	    d2hr = tcm_rd(ri + 16);
+	LOG("7: version %d, max rxbufpost %u, rx data offset %u, ring info %#x (ringmem %#x, %u flow / %u sub / %u cpl rings)",
+	    wl_version, tcm_rd16(sh + SH_MAX_RXBUFPOST), rx_dataoffset, ri, ringmem, tcm_rd16(ri + 52),
+	    tcm_rd16(ri + 54), tcm_rd16(ri + 56));
+	if (rx_dataoffset >= CTL_BUF_SIZE / 2) {
+		return EINVAL;
+	}
+	/* host memory: rings, scratch, ring update, ioctl request and the response/event buffers */
+	dma_size = 256 * 1024;
+	vm_offset_t va = 0;
+	if (kmem_alloc_contig(kernel_map, &va, dma_size, PAGE_MASK, 0, 0, KMA_ZERO | KMA_PERMANENT,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		LOG("7: no contiguous memory");
+		return ENOMEM;
+	}
+	dma_va = (uint8_t *)va;
+	dma_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)va));
+	clean_dcache(va, dma_size, 0);
+	const uint16_t *isz = wl_version >= 7 ? ring_isz_v7 : ring_isz_pre7;
+	for (int i = 0; i < 5; i++) {
+		struct wring *rg = &rings[i];
+		rg->max = ring_max[i];
+		rg->isz = isz[i];
+		rg->va = dma_carve((uint32_t)rg->max * rg->isz, &rg->pa);
+		if (rg->va == NULL) {
+			return ENOMEM;
+		}
+		if (i < 2) {
+			rg->widx = h2dw + 4 * i;
+			rg->ridx = h2dr + 4 * i;
+		} else {
+			rg->widx = d2hw + 4 * (i - 2);
+			rg->ridx = d2hr + 4 * (i - 2);
+		}
+		uint32_t d = ringmem + 16 * i;
+		tcm_wr16(d + 4, rg->max);
+		tcm_wr16(d + 6, rg->isz);
+		tcm_wr(d + 8, (uint32_t)rg->pa);
+		tcm_wr(d + 12, (uint32_t)(rg->pa >> 32));
+		rg->w = rg->r = 0;
+	}
+	uint64_t spa, upa;
+	if (dma_carve(8, &spa) == NULL || dma_carve(1024, &upa) == NULL ||
+	    (ioct_va = dma_carve(IOCT_MAX, &ioct_pa)) == NULL) {
+		return ENOMEM;
+	}
+	for (int i = 0; i < NRESP + NEVENT; i++) {
+		if ((resp_va[i] = dma_carve(CTL_BUF_SIZE, &resp_pa[i])) == NULL) {
+			return ENOMEM;
+		}
+	}
+	tcm_wr(sh + SH_DMA_SCRATCH_ADDR, (uint32_t)spa);
+	tcm_wr(sh + SH_DMA_SCRATCH_ADDR + 4, (uint32_t)(spa >> 32));
+	tcm_wr(sh + SH_DMA_SCRATCH_LEN, 8);
+	tcm_wr(sh + SH_DMA_RINGUPD_ADDR, (uint32_t)upa);
+	tcm_wr(sh + SH_DMA_RINGUPD_ADDR + 4, (uint32_t)(upa >> 32));
+	tcm_wr(sh + SH_DMA_RINGUPD_LEN, 1024);
+	if (wl_version >= 6) {
+		uint32_t cap = (uint32_t)wl_version | HOSTCAP_DS_NO_OOB_DW;
+		if (flags & SH_FLAG_HOSTRDY_DB1) {
+			cap |= HOSTCAP_H2D_ENABLE_HOSTRDY;
+		}
+		tcm_wr(sh + SH_HOST_CAP, cap);
+		tcm_wr(sh + SH_HOST_CAP2, 0);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	LOG("7: host memory %#llx..%#llx (%u bytes used), rings at %#llx", dma_pa, dma_pa + dma_size, dma_used,
+	    rings[0].pa);
+	/* polled: interrupts masked, pending ones cleared */
+	bp_wr(pcie2->base + PCIE2_MAILBOXMASK, 0);
+	bp_wr(pcie2->base + PCIE2_MAILBOXINT, bp_rd(pcie2->base + PCIE2_MAILBOXINT));
+	if (flags & SH_FLAG_HOSTRDY_DB1) {
+		bp_wr(pcie2->base + PCIE2_H2D_MAILBOX_1, 1);    /* brcmf_pcie_hostready */
+	}
+	for (uint32_t i = 0; i < NRESP; i++) {
+		post_buf(MT_IOCTLRESP_BUF_POST, i);
+	}
+	for (uint32_t i = NRESP; i < NRESP + NEVENT; i++) {
+		post_buf(MT_EVENT_BUF_POST, i);
+	}
+	IOSleep(20);
+	(void)ctrl_poll(0, NULL, 0, NULL);
+	LOG("7: control rings: submit w %u r %u, complete w %u", R_CTRL_SUB->w, tcm_rd16(R_CTRL_SUB->ridx),
+	    tcm_rd16(R_CTRL_CPL->widx));
+
+	char ver[257];
+	bzero(ver, sizeof(ver));
+	int r = iovar_get("ver", (uint8_t *)ver, 256);
+	for (int i = 0; ver[i]; i++) {
+		if (ver[i] == '\n' || ver[i] == '\r') {
+			ver[i] = ' ';
+		}
+	}
+	LOG("7: ver: %d \"%s\"", r, ver);
+	if (r != 0) {
+		fw_console("ver failed");
+		return EIO;
+	}
+	uint8_t mac[6] = { 0 };
+	r = iovar_get("cur_etheraddr", mac, 6);
+	LOG("7: MAC %02x:%02x:%02x:%02x:%02x:%02x (%d)", mac[0], mac[1], mac[2], mac[3], mac[4], mac[5], r);
+	clm_load();
+	fw_console("after step 7");
+	LOG("7: MSGBUF UP");
+	return 0;
+}
+
+static int
+step_scan(void)
+{
+	uint8_t mask[18] = { 0 };
+	int r = iovar_get("event_msgs", mask, sizeof(mask));
+	mask[WLC_E_ESCAN_RESULT / 8] |= 1u << (WLC_E_ESCAN_RESULT % 8);
+	int r2 = iovar_set("event_msgs", mask, sizeof(mask));
+	int r3 = iovar_set("mpc", (const uint8_t[]){ 0, 0, 0, 0 }, 4);
+	int r4 = cmd_int(WLC_SET_INFRA, 1);
+	int r5 = cmd_int(WLC_SET_PM, 0);
+	int r6 = cmd_int(WLC_UP, 1);
+	LOG("8: event_msgs %d/%d, mpc 0 %d, infra %d, pm %d, up %d", r, r2, r3, r4, r5, r6);
+	if (r6 != 0) {
+		fw_console("up failed");
+		return EIO;
+	}
+	/* brcmf_escan_params_le v1: version, action START, sync id, then brcmf_scan_params_le
+	 * (any SSID, broadcast BSSID, any BSS type, active, firmware defaults, all channels) */
+	uint8_t p[8 + 64];
+	bzero(p, sizeof(p));
+	put32(p, 1);
+	put16(p + 4, 1);
+	put16(p + 6, 0x5338);
+	uint8_t *sp = p + 8;
+	memset(sp + 36, 0xff, 6);
+	sp[42] = 2;
+	sp[43] = 0;
+	put32(sp + 44, 0xffffffffu);
+	put32(sp + 48, 0xffffffffu);
+	put32(sp + 52, 0xffffffffu);
+	put32(sp + 56, 0xffffffffu);
+	put32(sp + 60, 0);
+	nnets = 0;
+	nevents = 0;
+	escan_status = -1;
+	r = iovar_set("escan", p, sizeof(p));
+	LOG("8: escan %d", r);
+	if (r != 0) {
+		fw_console("escan failed");
+		return EIO;
+	}
+	for (int i = 0; i < 1500 && escan_status < 0; i++) {   /* 15 s */
+		(void)ctrl_poll(0, NULL, 0, NULL);
+		IOSleep(10);
+	}
+	fw_console("after the scan");
+	LOG("8: scan %s (status %d), %u events, %u networks", escan_status == 0 ? "done" :
+	    escan_status < 0 ? "TIMED OUT" : "ended", escan_status, nevents, nnets);
+	for (unsigned i = 0; i < nnets; i++) {
+		uint16_t cs = nets[i].chanspec;
+		LOG("8: NET %2u ch %3u%s %4d dBm %02x:%02x:%02x:%02x:%02x:%02x \"%s\"", i + 1, cs & 0xff,
+		    (cs & 0xc000) == 0xc000 ? " 5G" : "   ", nets[i].rssi, nets[i].bssid[0], nets[i].bssid[1],
+		    nets[i].bssid[2], nets[i].bssid[3], nets[i].bssid[4], nets[i].bssid[5], nets[i].ssid);
+	}
+	return nnets ? 0 : ENOENT;
 }
 
