diff --git a/bsd/dev/s8_wlan.c b/bsd/dev/s8_wlan.c
index 15f9b3f..dae223d 100644
--- a/bsd/dev/s8_wlan.c
+++ b/bsd/dev/s8_wlan.c
@@ -849,10 +849,12 @@ step_firmware(void)
 	}
